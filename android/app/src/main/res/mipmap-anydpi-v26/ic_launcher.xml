<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <!-- Без monochrome Android 13+ с включёнными "цветными значками"
         (Material You) сам придумывает силуэт из foreground — и не всегда
         удачно. Foreground уже сплошной белый силуэт на прозрачном фоне,
         так что годится и как monochrome напрямую. -->
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
